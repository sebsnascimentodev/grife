# Redis (Railway ou qualquer instância Redis compatível)
REDIS_URL=redis://default:senha@host:porta

# Segredo usado para assinar o token de sessão
ADMIN_TOKEN_SECRET=troque-este-segredo

PORT=4000

# Admin inicial, criado automaticamente no primeiro boot (se nenhum admin existir ainda)
ADMIN_EMAIL=admin@grife.com
ADMIN_SENHA=troque-esta-senha
ADMIN_CPF=52998224725

# Mercado Pago — credenciais de TESTE (sandbox). Nunca use o Access Token no client.
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxx
MP_PUBLIC_KEY=APP_USR-xxxxxxxxxxxxxxx
